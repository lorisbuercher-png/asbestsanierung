/* RESET */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Montserrat',sans-serif;
    background:#0d0d0d;
    color:#fff;
    line-height:1.6;
}

/* CONTAINER */

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

/* HEADER */

.header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:999;
    background:rgba(10,10,10,.95);
    backdrop-filter:blur(10px);
    border-bottom:1px solid rgba(255,255,255,.05);
}

.header .container{
    display:flex;
    justify-content:space-between;
    align-items:center;
    height:90px;
}

.logo img{
    height:60px;
}

.navbar ul{
    display:flex;
    list-style:none;
    gap:35px;
}

.navbar a{
    text-decoration:none;
    color:white;
    font-weight:500;
    transition:.3s;
}

.navbar a:hover{
    color:#e5b300;
}

.btn-nav{
    background:#e5b300;
    color:#111;
    text-decoration:none;
    padding:14px 22px;
    border-radius:8px;
    font-weight:700;
}

/* HERO */

.hero{
    min-height:100vh;
    background:
    linear-gradient(
        rgba(0,0,0,.70),
        rgba(0,0,0,.70)
    ),
    url('https://images.unsplash.com/photo-1504307651254-35680f356dfd');

    background-size:cover;
    background-position:center;

    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;

    padding:120px 20px;
}

.hero-content{
    max-width:900px;
}

.hero-subtitle{
    color:#e5b300;
    font-weight:700;
    letter-spacing:2px;
}

.hero h1{
    font-size:clamp(3rem,8vw,6rem);
    line-height:1.1;
    margin:20px 0;
}

.hero h1 span{
    color:#e5b300;
}

.hero p{
    font-size:1.2rem;
    color:#ccc;
    max-width:700px;
    margin:auto;
}

.hero-buttons{
    margin-top:40px;
    display:flex;
    gap:20px;
    justify-content:center;
    flex-wrap:wrap;
}

.btn-primary{
    background:#e5b300;
    color:#111;
    text-decoration:none;
    padding:16px 28px;
    border-radius:8px;
    font-weight:700;
}

.btn-secondary{
    border:2px solid #fff;
    color:white;
    text-decoration:none;
    padding:16px 28px;
    border-radius:8px;
}

/* SECTIONS */

section{
    padding:100px 0;
}

.section-title{
    text-align:center;
    margin-bottom:60px;
}

.section-title span{
    color:#e5b300;
    font-weight:700;
}

.section-title h2{
    font-size:3rem;
    margin-top:10px;
}

/* SERVICES */

.services-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
}

.service-card{
    background:rgba(255,255,255,.04);
    backdrop-filter:blur(15px);
    border:1px solid rgba(255,255,255,.05);
    padding:35px;
    border-radius:20px;
    transition:.35s;
}

.service-card:hover{
    transform:translateY(-10px);
    border-color:#e5b300;
    box-shadow:0 20px 40px rgba(229,179,0,.15);
}

.service-card h3{
    margin-bottom:15px;
    color:#e5b300;
}

/* ABOUT */

.about{
    background:#121212;
}

.about-grid{
    display:grid;
    grid-template-columns:2fr 1fr;
    gap:60px;
}

.section-tag{
    color:#e5b300;
    font-weight:700;
}

.about h2{
    margin:20px 0;
    font-size:3rem;
}

.about p{
    color:#cfcfcf;
}

.about-list{
    list-style:none;
    margin-top:25px;
}

.about-list li{
    margin-bottom:15px;
}

.stats-box{
    background:#1a1a1a;
    border:1px solid rgba(229,179,0,.2);
    border-radius:20px;
    padding:40px;
}

.stat{
    margin-bottom:30px;
}

.stat h3{
    font-size:3rem;
    color:#e5b300;
}

/* PROJECTS */

.projects-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:25px;
}

.project-card{
    overflow:hidden;
    border-radius:20px;
    position:relative;
}

.project-card img{
    width:100%;
    height:350px;
    object-fit:cover;
    transition:.5s;
}

.project-card:hover img{
    transform:scale(1.1);
}

.project-info{
    position:absolute;
    bottom:0;
    left:0;
    width:100%;
    background:linear-gradient(
    transparent,
    rgba(0,0,0,.9));
    padding:30px;
}

.project-info h3{
    color:white;
}

/* CONTACT */

.contact{
    background:#111;
}

.contact-form{
    max-width:700px;
    margin:auto;
    display:flex;
    flex-direction:column;
    gap:20px;
}

.contact-form input,
.contact-form textarea{
    background:#1d1d1d;
    border:none;
    color:white;
    padding:18px;
    border-radius:10px;
}

.contact-form button{
    background:#e5b300;
    color:#111;
    border:none;
    padding:18px;
    font-weight:700;
    cursor:pointer;
    border-radius:10px;
}

/* FOOTER */

footer{
    background:#090909;
    padding:40px 0;
}

.footer-content{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.footer-content img{
    height:50px;
}

.footer-content p{
    color:#999;
}

/* MOBILE */

@media(max-width:900px){

    .navbar{
        display:none;
    }

    .btn-nav{
        display:none;
    }

    .about-grid{
        grid-template-columns:1fr;
    }

    .footer-content{
        flex-direction:column;
        gap:20px;
    }

    .hero h1{
        font-size:3rem;
    }

    .section-title h2{
        font-size:2rem;
    }
}