<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>F&B Spezialbau – Bauunternehmen Schweiz</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800;900&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --yellow:#F5C200;
  --yellow-hover:#D9A900;
  --navy:#1C2233;
  --dark:#1A1A2E;
  --mid:#555;
  --light:#F7F7F7;
  --white:#FFFFFF;
  --border:#E8E8E8;
}
html{scroll-behavior:smooth}
body{font-family:'Nunito Sans',sans-serif;background:var(--white);color:var(--navy);overflow-x:hidden}

/* TOPBAR */
.topbar{background:var(--navy);color:#aaa;font-size:12.5px;padding:8px 0}
.tb{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.tb a{color:#aaa;text-decoration:none;transition:color .18s}
.tb a:hover{color:var(--yellow)}
.tb-l,.tb-r{display:flex;gap:18px;align-items:center}

/* NAV */
header{background:var(--white);position:sticky;top:0;z-index:200;border-bottom:3px solid var(--yellow)}
.nav{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;justify-content:space-between;align-items:center;height:78px}
.logo-wrap{display:flex;align-items:center;gap:12px;text-decoration:none}
.logo-img{height:54px;width:auto;object-fit:contain}
.logo-txt{font-family:'Oswald',sans-serif;font-weight:700;font-size:22px;color:var(--navy);letter-spacing:.5px;line-height:1.1}
.logo-txt small{display:block;font-size:10px;font-weight:600;color:var(--mid);letter-spacing:2.5px;text-transform:uppercase}
nav ul{list-style:none;display:flex;gap:4px;align-items:center}
nav ul a{text-decoration:none;color:var(--navy);font-size:13.5px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:7px 14px;transition:color .18s;border-bottom:2px solid transparent}
nav ul a:hover{color:var(--yellow-hover);border-color:var(--yellow)}
.nav-cta{background:var(--yellow)!important;color:var(--navy)!important;border:none!important;padding:10px 24px!important;font-weight:800!important}
.nav-cta:hover{background:var(--yellow-hover)!important}

/* HERO */
.hero{position:relative;background:var(--navy);min-height:88vh;display:flex;align-items:center;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:linear-gradient(100deg,rgba(28,34,51,.95) 48%,rgba(28,34,51,.55) 100%),url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1600&q=80') center/cover no-repeat}
.hero-inner{position:relative;max-width:1200px;margin:0 auto;padding:100px 24px 80px;width:100%}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--yellow);font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:18px}
.hero-eyebrow::before{content:'';display:block;width:30px;height:3px;background:var(--yellow)}
.hero h1{font-family:'Oswald',sans-serif;font-size:clamp(44px,5.5vw,78px);font-weight:700;line-height:1.0;text-transform:uppercase;color:var(--white);margin-bottom:8px}
.hero h1 .accent{color:var(--yellow);font-style:italic}
.hero-sub{color:rgba(255,255,255,.7);font-size:16px;line-height:1.7;max-width:500px;margin:18px 0 34px}
.btn-y{background:var(--yellow);color:var(--navy);padding:14px 32px;font-weight:800;font-size:13.5px;text-transform:uppercase;letter-spacing:.8px;text-decoration:none;display:inline-block;border:2px solid var(--yellow);transition:all .2s}
.btn-y:hover{background:var(--yellow-hover);border-color:var(--yellow-hover)}
.btn-w{border:2px solid rgba(255,255,255,.5);color:var(--white);padding:14px 32px;font-weight:800;font-size:13.5px;text-transform:uppercase;letter-spacing:.8px;text-decoration:none;display:inline-block;transition:all .2s;margin-left:12px}
.btn-w:hover{border-color:var(--yellow);color:var(--yellow)}
.hero-stats{display:flex;gap:48px;margin-top:56px;padding-top:32px;border-top:1px solid rgba(255,255,255,.15)}
.hs .n{font-family:'Oswald',sans-serif;font-size:44px;font-weight:700;color:var(--yellow);line-height:1}
.hs .l{font-size:12px;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:1.5px;margin-top:4px}
.hero-ybar{position:absolute;left:0;bottom:0;width:100%;height:5px;background:var(--yellow)}

/* INTRO BAND */
.intro-band{background:var(--white);padding:72px 0}
.intro-inner{max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 2fr;gap:48px;align-items:center}
.intro-left h2{font-family:'Oswald',sans-serif;font-size:clamp(28px,3vw,40px);font-weight:700;text-transform:uppercase;line-height:1.1;color:var(--navy)}
.intro-left h2 .y{color:var(--yellow-hover)}
.intro-divider{width:60px;height:4px;background:var(--yellow);margin:16px 0}
.intro-right{color:var(--mid);font-size:15.5px;line-height:1.75;border-left:3px solid var(--yellow);padding-left:28px}

/* ICONS ROW */
.icon-grid{max-width:1200px;margin:0 auto 72px;padding:0 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border)}
.icon-card{background:var(--white);padding:32px 24px;text-align:center;transition:background .2s}
.icon-card:hover{background:var(--light)}
.icon-card .ic{font-size:44px;margin-bottom:14px;display:block}
.icon-card h3{font-family:'Oswald',sans-serif;font-size:17px;font-weight:700;text-transform:uppercase;color:var(--navy);margin-bottom:8px}
.icon-card p{color:var(--mid);font-size:13.5px;line-height:1.65}

/* ABOUT SPLIT */
.about{background:var(--light);padding:88px 0}
.about-inner{max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.about-img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--yellow-hover);margin-bottom:12px}
.eyebrow svg{width:24px;height:2px}
.sec-title{font-family:'Oswald',sans-serif;font-size:clamp(28px,3vw,42px);font-weight:700;text-transform:uppercase;line-height:1.1;margin-bottom:16px;color:var(--navy)}
.body-text{color:var(--mid);font-size:15px;line-height:1.75;margin-bottom:12px}
.check-list{list-style:none;margin:18px 0 28px;display:flex;flex-direction:column;gap:0}
.check-list li{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--border);font-size:14.5px;font-weight:700;color:var(--navy)}
.check-list li::before{content:'';width:10px;height:10px;background:var(--yellow);flex-shrink:0}

/* SERVICES GRID */
.services{background:var(--white);padding:88px 0}
.sec-head{text-align:center;max-width:600px;margin:0 auto 50px}
.sec-head .eyebrow{justify-content:center}
.svc-grid{max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.svc-card{background:var(--light);overflow:hidden;transition:box-shadow .22s,transform .22s;border-top:3px solid transparent}
.svc-card:hover{box-shadow:0 10px 36px rgba(0,0,0,.09);transform:translateY(-4px);border-color:var(--yellow)}
.svc-img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;transition:transform .4s}
.svc-card:hover .svc-img{transform:scale(1.04)}
.svc-body{padding:20px 22px 24px;display:flex;flex-direction:column;gap:0}
.svc-ic-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.svc-ic{width:44px;height:44px;background:var(--yellow);display:flex;align-items:center;justify-content:center;font-size:22px}
.svc-n{font-family:'Oswald',sans-serif;font-size:12px;font-weight:600;color:#ccc;letter-spacing:1px}
.svc-card h3{font-family:'Oswald',sans-serif;font-size:19px;font-weight:700;text-transform:uppercase;margin-bottom:7px;color:var(--navy)}
.svc-card p{color:var(--mid);font-size:13.5px;line-height:1.65}

/* SPLIT BANNER — Firmen-Weiche */
.split-intro{background:var(--navy);text-align:center;padding:48px 24px 0}
.split-intro p{color:rgba(255,255,255,.55);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:3px;margin-bottom:10px}
.split-intro h2{font-family:'Oswald',sans-serif;font-size:clamp(26px,3.5vw,44px);font-weight:700;text-transform:uppercase;color:var(--white);line-height:1.1}
.split-intro h2 span{color:var(--yellow)}
.split-banner{display:grid;grid-template-columns:1fr 1fr}
.split-l,.split-r{position:relative;min-height:520px;overflow:hidden;display:flex;align-items:flex-end;cursor:pointer}
.split-l img,.split-r img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
.split-l:hover img,.split-r:hover img{transform:scale(1.06)}
/* Left = FB Spezialbau — dark navy */
.split-l::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(28,34,51,.92) 0%,rgba(28,34,51,.5) 60%,rgba(28,34,51,.2) 100%);transition:opacity .3s}
/* Right = FBA Asbestsanierung — yellow tinted */
.split-r::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(200,140,0,.92) 0%,rgba(180,120,0,.55) 60%,rgba(140,100,0,.15) 100%);transition:opacity .3s}
.split-l:hover::after{opacity:.85}
.split-r:hover::after{opacity:.85}
/* Divider line in center */
.split-banner::before{content:'ODER';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:10;background:var(--white);color:var(--navy);font-family:'Oswald',sans-serif;font-size:13px;font-weight:700;letter-spacing:3px;padding:10px 14px;pointer-events:none}
.split-content{position:relative;z-index:2;padding:44px 48px}
/* Left content */
.split-l .split-tag{display:inline-block;background:var(--yellow);color:var(--navy);font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;padding:5px 12px;margin-bottom:14px}
.split-l .split-content h3{font-family:'Oswald',sans-serif;font-size:clamp(26px,3vw,42px);font-weight:700;text-transform:uppercase;color:var(--white);line-height:1.05;margin-bottom:12px}
.split-l .split-content p{color:rgba(255,255,255,.72);font-size:14.5px;line-height:1.7;margin-bottom:10px}
.split-l .split-feats{list-style:none;margin:14px 0 24px;display:flex;flex-direction:column;gap:0}
.split-l .split-feats li{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.8);font-size:13.5px;font-weight:600}
.split-l .split-feats li::before{content:'';width:8px;height:8px;background:var(--yellow);flex-shrink:0}
/* Right content */
.split-r .split-tag{display:inline-block;background:var(--navy);color:var(--white);font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;padding:5px 12px;margin-bottom:14px}
.split-r .split-content h3{font-family:'Oswald',sans-serif;font-size:clamp(26px,3vw,42px);font-weight:700;text-transform:uppercase;color:var(--white);line-height:1.05;margin-bottom:12px}
.split-r .split-content p{color:rgba(255,255,255,.85);font-size:14.5px;line-height:1.7;margin-bottom:10px}
.split-r .split-feats{list-style:none;margin:14px 0 24px;display:flex;flex-direction:column;gap:0}
.split-r .split-feats li{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid rgba(28,34,51,.2);color:rgba(255,255,255,.9);font-size:13.5px;font-weight:600}
.split-r .split-feats li::before{content:'✓';color:var(--navy);font-weight:900;font-size:14px;flex-shrink:0}
/* Buttons */
.btn-white{display:inline-flex;align-items:center;gap:8px;background:var(--white);color:var(--navy);padding:13px 28px;font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.6px;text-decoration:none;transition:all .2s}
.btn-white:hover{background:var(--yellow);color:var(--navy)}
.btn-navy{display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:var(--white);padding:13px 28px;font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.6px;text-decoration:none;border:2px solid var(--navy);transition:all .2s}
.btn-navy:hover{background:transparent;color:var(--navy);border-color:var(--navy)}
/* External link badge */
.ext-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);color:rgba(255,255,255,.7);font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:5px 10px;margin-bottom:16px}
.ext-badge span{color:var(--yellow)}

/* ASBESTOS FULL SECTION */
.asbestos{padding:88px 0;background:var(--navy)}
.asb-inner{max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.asb-img-wrap{position:relative}
.asb-img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.asb-badge{position:absolute;top:20px;left:20px;background:var(--yellow);padding:12px 20px}
.asb-badge span{font-family:'Oswald',sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;color:var(--navy);letter-spacing:.5px}
.asb-content .eyebrow{color:var(--yellow)}
.asb-content .sec-title{color:var(--white)}
.asb-content .body-text{color:rgba(255,255,255,.65)}
.asb-list{list-style:none;margin:18px 0 28px;display:flex;flex-direction:column;gap:0}
.asb-list li{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:14.5px;font-weight:700;color:rgba(255,255,255,.85)}
.asb-list li::before{content:'✓';color:var(--yellow);font-weight:900;font-size:16px;flex-shrink:0}
.asb-ext-link{display:inline-flex;align-items:center;gap:10px;background:var(--yellow);color:var(--navy);padding:14px 30px;font-weight:800;font-size:13.5px;text-transform:uppercase;letter-spacing:.8px;text-decoration:none;margin-top:4px;transition:background .2s}
.asb-ext-link:hover{background:var(--yellow-hover)}

/* WHY */
.why{padding:88px 0;background:var(--light)}
.why-inner{max-width:1200px;margin:0 auto;padding:0 24px}
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:48px}
.why-card{background:var(--white);padding:32px 26px;border-bottom:3px solid transparent;transition:all .2s}
.why-card:hover{border-color:var(--yellow);box-shadow:0 6px 24px rgba(0,0,0,.07)}
.why-icon{font-size:36px;margin-bottom:14px;display:block}
.why-card h4{font-family:'Oswald',sans-serif;font-size:18px;font-weight:700;text-transform:uppercase;margin-bottom:8px;color:var(--navy)}
.why-card p{color:var(--mid);font-size:14px;line-height:1.65}

/* CTA BAND */
.cta-band{background:var(--yellow);padding:64px 24px;text-align:center}
.cta-band h2{font-family:'Oswald',sans-serif;font-size:clamp(26px,4vw,48px);font-weight:700;text-transform:uppercase;color:var(--navy);margin-bottom:10px}
.cta-band p{color:rgba(28,34,51,.7);font-size:16px;margin-bottom:28px}
.btn-dark{background:var(--navy);color:var(--white);padding:14px 36px;font-weight:800;font-size:14px;text-transform:uppercase;letter-spacing:.8px;text-decoration:none;display:inline-block;transition:background .2s}
.btn-dark:hover{background:var(--dark)}

/* CONTACT */
.contact{padding:88px 0;background:var(--white)}
.contact-inner{max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1.2fr;gap:64px;align-items:start}
.c-info{display:flex;flex-direction:column;gap:20px;margin-top:8px}
.c-row{display:flex;gap:14px;align-items:flex-start}
.c-icon{width:46px;height:46px;background:var(--yellow);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.c-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:var(--mid);margin-bottom:3px}
.c-val{font-size:15px;font-weight:700;color:var(--navy)}
.c-val a{color:var(--navy);text-decoration:none;transition:color .18s}
.c-val a:hover{color:var(--yellow-hover)}
.contact-form{display:flex;flex-direction:column;gap:14px;background:var(--light);padding:36px;border-top:4px solid var(--yellow)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.contact-form input,.contact-form select,.contact-form textarea{width:100%;padding:13px 16px;border:1px solid var(--border);background:var(--white);font-family:'Nunito Sans',sans-serif;font-size:14px;color:var(--navy);outline:none;transition:border-color .18s}
.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{border-color:var(--yellow-hover)}
.contact-form textarea{resize:vertical;min-height:110px}
.btn-submit{background:var(--navy);color:var(--white);border:none;padding:14px 36px;font-family:'Nunito Sans',sans-serif;font-weight:800;font-size:13.5px;text-transform:uppercase;letter-spacing:.8px;cursor:pointer;align-self:flex-start;transition:background .2s}
.btn-submit:hover{background:var(--yellow);color:var(--navy)}

/* FOOTER */
footer{background:var(--navy);padding:64px 0 24px}
.footer-grid{max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px}
.f-brand p{color:#6a7080;font-size:14px;line-height:1.7;margin-top:14px}
.f-col h5{font-family:'Oswald',sans-serif;font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:1.5px;color:var(--white);margin-bottom:16px;padding-bottom:8px;border-bottom:2px solid var(--yellow);display:inline-block}
.f-col ul{list-style:none;display:flex;flex-direction:column;gap:9px}
.f-col a{color:#6a7080;text-decoration:none;font-size:14px;transition:color .18s}
.f-col a:hover{color:var(--yellow)}
.footer-bar{max-width:1200px;margin:48px auto 0;padding:20px 24px 0;border-top:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.footer-bar p{color:#444;font-size:13px}

/* RESPONSIVE */
@media(max-width:960px){
  .about-inner,.asb-inner,.contact-inner,.intro-inner{grid-template-columns:1fr}
  .split-banner{grid-template-columns:1fr}
  .split-l,.split-r{min-height:420px}
  .svc-grid{grid-template-columns:1fr 1fr}
  .why-grid{grid-template-columns:1fr 1fr}
  .icon-grid{grid-template-columns:1fr 1fr}
  .footer-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  nav ul{display:none}
  .svc-grid,.why-grid,.icon-grid,.form-row{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr}
  .hero-stats{gap:24px}
}
</style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <div class="tb">
    <div class="tb-l">
      <span>✉ <a href="mailto:info@fbspezialbau.ch">info@fbspezialbau.ch</a></span>
      <span>☎ <a href="tel:+41000000000">+41 00 000 00 00</a></span>
    </div>
    <div class="tb-r">
      <span>Mo–Fr: 07:00 – 17:30 Uhr</span>
    </div>
  </div>
</div>

<!-- HEADER -->
<header>
  <div class="nav">
    <a href="#" class="logo-wrap">
      <img src="data:image/jpeg;base64," class="logo-img" alt="F&B Spezialbau Logo">
    </a>
    <nav>
      <ul>
        <li><a href="#ueber-uns">Über uns</a></li>
        <li><a href="#leistungen">Leistungen</a></li>
        <li><a href="#asbestsanierung">Asbestsanierung</a></li>
        <li><a href="#kontakt" class="nav-cta">Anfragen</a></li>
      </ul>
    </nav>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-ybar"></div>
  <div class="hero-inner">
    <div class="hero-eyebrow">Spezialbauunternehmen Schweiz</div>
    <h1>
      Bauen mit<br>
      <span class="accent">Herz</span><br>
      und Verstand.
    </h1>
    <p class="hero-sub">F&B Spezialbau steht seit über 15 Jahren für präzise Handwerksarbeit und höchste Qualität – von Umbau und Renovation bis hin zu Abbruch und Sanierung.</p>
    <div>
      <a href="#leistungen" class="btn-y">Unsere Leistungen</a>
      <a href="#kontakt" class="btn-w">Kostenlose Anfrage</a>
    </div>
    <div class="hero-stats">
      <div class="hs"><div class="n">15+</div><div class="l">Jahre Erfahrung</div></div>
      <div class="hs"><div class="n">300+</div><div class="l">Projekte</div></div>
      <div class="hs"><div class="n">100%</div><div class="l">CH-Qualität</div></div>
    </div>
  </div>
</section>

<!-- INTRO + ICONS (Brixel style) -->
<section class="intro-band">
  <div class="intro-inner">
    <div class="intro-left">
      <h2>Gemeinsam Ihren <span class="y">Traum</span> bauen.</h2>
